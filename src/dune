(executable
 (name main)
 (modules main)
 (modes js)
 (libraries
  js_of_ocaml
  js_of_ocaml-ppx
  js_of_ocaml-lwt
  js_of_ocaml-tyxml
  tyxml
  lwt
  astring
  pages
  components
  blobs
  i18n)
 (js_of_ocaml
  (javascript_files
   bootstrap.js
   ../static/editor.js
   jszip.min.js
   ../static/sls.min.js
   ../static/sls-sync-bridge.min.js
   markdown-it.min.js
   markdown-it-mathjax.js
   viz.js
   full.render.js
   ../static/mathjax.min.js))
 (preprocess
  (pps js_of_ocaml-ppx)))

(library
 (name helpers)
 (modules helpers)
 (wrapped false)
 (libraries js_of_ocaml js_of_ocaml-tyxml js_of_ocaml-lwt lwt yojson astring)
 (preprocess
  (pps js_of_ocaml-ppx)))

(library
 (name blobs)
 (modules blobs)
 (wrapped false)
 (libraries js_of_ocaml)
 (preprocess
  (pps js_of_ocaml-ppx ppx_blob))
 (preprocessor_deps
  (file ../static/editor.css)
  (file bootstrap.css)
  (file ../static/style.css)
  (file ../static/yoda-cameling-loop.gif)
  (file ../static/yoda.png)))

;; Rule to download Bootstrap JS

(rule
 (targets bootstrap.js)
 (action
  (progn
   (run
    curl
    -L
    -o
    %{targets}
    https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js))))

;; Rule to download Bootstrap CSS

(rule
 (targets bootstrap.css)
 (action
  (progn
   (run
    curl
    -L
    -o
    %{targets}
    https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css))))

(rule
 (targets bootstrap-icons.css)
 (action
  (progn
   (run
    curl
    -L
    -o
    %{targets}
    https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css))))

;; Rule to download JsZip

(rule
 (targets jszip.min.js)
 (action
  (progn
   (run
    curl
    -L
    -o
    %{targets}
    https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js))))

;; Rule to download MarkdownIT

(rule
 (targets markdown-it.min.js)
 (action
  (progn
   (run
    curl
    -L
    -o
    %{targets}
    https://unpkg.com/markdown-it@14.3.2/dist/markdown-it.min.js))))

;; Rule to download Viz.js

(rule
 (targets viz.js)
 (action
  (progn
   (run curl -L -o %{targets} https://unpkg.com/viz.js@2.1.2/viz.js))))

;; Rule to download Viz.js Graphviz renderer

(rule
 (targets full.render.js)
 (action
  (progn
   (run curl -L -o %{targets} https://unpkg.com/viz.js@2.1.2/full.render.js))))

;; Rule to download Markdown-it MathJax plugin

(rule
 (targets markdown-it-mathjax.js)
 (action
  (progn
   (run
    curl
    -L
    -o
    %{targets}
    https://cdn.jsdelivr.net/npm/markdown-it-mathjax@2.0.0/markdown-it-mathjax.js))))
